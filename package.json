{
  "name": "dsh-autorestart",
  "version": "0.8.3",
  "type": "module",
  "description": "DeepSeek Harness plugin: restart without losing work. Waits until every conversation is idle, restarts the host, then automatically resumes the interrupted sessions. AI-generated, not human-reviewed: use with caution.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "continuation",
    "session-resume",
    "graceful-restart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eason-22/dsh-autorestart.git"
  },
  "homepage": "https://github.com/Eason-22/dsh-autorestart#readme",
  "bugs": {
    "url": "https://github.com/Eason-22/dsh-autorestart/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "supervisor/supervisor.js",
    "scripts/*.ps1",
    "scripts/*.cmd",
    "scripts/*.sh",
    "scripts/*.mjs",
    "scripts/README.md",
    "scripts/rescue-strings.zh.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
