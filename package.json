{
  "name": "dsh-autorestart",
  "version": "0.9.7",
  "type": "module",
  "description": "DSH plugin: restarts only when every session is idle, waits for plugin installs, then resumes the sessions it interrupted; adds a countdown shutdown, a pre-restart snapshot, and a windowless launcher.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "continuation",
    "session-resume",
    "graceful-restart",
    "plugin-install"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eason-22/dsh-autorestart.git"
  },
  "homepage": "https://github.com/Eason-22/dsh-autorestart#readme",
  "bugs": {
    "url": "https://github.com/Eason-22/dsh-autorestart/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "supervisor/supervisor.js",
    "scripts/build-icon.mjs",
    "scripts/clear-dsh-auth-cookies.mjs",
    "scripts/cleanup-shell-backups.mjs",
    "scripts/run-tests.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "assets/*.ico",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
